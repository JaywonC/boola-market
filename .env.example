# mock (default) confirms the magic link on the next screen.
# supabase sends a real email via the Auth OTP API. The callback route
# still needs the session exchange before that path can sign someone in.
AUTH_PROVIDER=mock

# Required for any deployed environment. The local demo falls back to a
# built-in development secret if this is unset.
AUTH_SECRET=

# Used when AUTH_PROVIDER=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Not read by the local demo. The Supabase service role belongs
# in server-only data access once src/lib/db/supabase.ts is implemented.
SUPABASE_SERVICE_ROLE_KEY=

# local (default) stores data in data/store.json.
# supabase is reserved for src/lib/db/supabase.ts and currently throws
# a clear error so a half-configured backend cannot silently drop data.
DATA_PROVIDER=local
